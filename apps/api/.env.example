# Copy to `.env.development.local` (or `.env.production.local`) and fill in.
# `shared/config` loads `.env.<NODE_ENV>.local` then `.env`, and refuses to boot
# if any variable below without a default is missing or blank.

# Port the API listens on (Render sets this automatically). Optional, default 3000
PORT=3000

# Comma-separated list of allowed browser origins for CORS
# Optional, default http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Neon Postgres — POOLED connection string, used by the running app (ADR-0006)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Postgres — DIRECT (non-pooled) connection string, used by drizzle-kit
# migrations only (pnpm --filter @olc/api db:migrate). The app never opens it,
# so it is not part of the validated boot environment.
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Google OAuth client (Google Cloud Console). Scopes: openid email profile only.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Must exactly match an Authorized redirect URI on the OAuth client
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Secret used to sign the JWT the API issues after sign-in.
# At least 16 characters — boot fails otherwise.
JWT_SECRET=change-me-to-a-long-random-string

# Where the API redirects the browser after a successful sign-in
WEB_APP_URL=http://localhost:5173
