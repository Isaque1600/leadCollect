{
  "name": "@olc/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @olc/types run build && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm --filter @olc/types run build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@olc/types": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "3.0.2"
  }
}
