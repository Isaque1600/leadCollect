# ============================================================================
# Online Lead Collector — environment variables (all services)
#
# This is the consolidated reference. Each app also has its own scoped file:
#   apps/api/.env.example   apps/web/.env.example
#
# For local dev, copy the sections you need into apps/api/.env and
# apps/web/.env. For Docker Compose (ticket 15), a single root .env is read.
# On Render / Vercel these are set per environment in the dashboard
# (see docs/adr/0007-dev-prod-environments.md) — dev and prod never share.
# ============================================================================

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# Port the API listens on (Render sets this automatically)
PORT=3000

# Comma-separated list of allowed browser origins for CORS.
#   local:   http://localhost:5173
#   dev:     http://localhost:5173,https://<vercel-preview-alias>
#   prod:    https://<vercel-production-domain>
CORS_ORIGINS=http://localhost:5173

# Where the API redirects the browser after a successful sign-in (the SPA origin)
WEB_APP_URL=http://localhost:5173

# --- Database (ADR-0006) — needed once ticket 02 (Google login) is merged ---

# Neon Postgres POOLED connection string, used by the running app.
# For Docker Compose use: postgresql://olc:olc@db:5432/olc
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Postgres DIRECT (non-pooled) string, used by drizzle-kit migrations only
# (pnpm --filter @olc/api db:migrate). For Docker Compose: same as DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Google OAuth (ticket 02) — Google Cloud Console, scopes: openid email profile ---

GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Must exactly match an Authorized redirect URI on the OAuth client
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Secret used to sign the JWT the API issues after sign-in (long random string)
JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Web SPA (apps/web) — build-time, baked into the browser bundle by Vite.
# Must be prefixed VITE_. Not secret (visible in the browser).
# ---------------------------------------------------------------------------

#   local:   http://localhost:3000
#   Vercel Preview     -> the dev Render API URL (olc-api-dev)
#   Vercel Production   -> the prod Render API URL (olc-api)
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Docker Compose only (ticket 15) — the Postgres container
# ---------------------------------------------------------------------------

POSTGRES_USER=olc
POSTGRES_PASSWORD=olc
POSTGRES_DB=olc
